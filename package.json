{
  "name": "strava-runner-animation",
  "version": "1.0.0",
  "description": "Animated running route visualization from a Strava data export (GPX)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "type-check": "tsc --noEmit",
    "record": "npm run build && node dist/record/record.js",
    "test": "tsc && node --test \"dist/**/*.test.js\" \"test/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "playwright-core": "^1.65.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vue": "^3.5.13"
  }
}
